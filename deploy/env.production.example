# Production environment — copy to the APP ROOT on the server as `.env`
# (or set these as real environment variables in your host's panel).
# The server REFUSES to boot in production with placeholder/weak secrets.

NODE_ENV=production

# The port Node listens on. Shared hosts (Passenger) usually inject their own
# PORT automatically — leave this out there. Behind Nginx use e.g. 4000.
PORT=4000

# Your public origin, exactly as users will type it (scheme + domain, no slash).
CLIENT_ORIGIN=https://auction.example.com

# MySQL connection. Create the database + user first.
DATABASE_URL=mysql://auction_user:STRONG_DB_PASSWORD@127.0.0.1:3306/auction

# Generate each with:  openssl rand -base64 48
JWT_SECRET=REPLACE_ME_openssl_rand_base64_48
PEPPER=REPLACE_ME_openssl_rand_base64_48
JWT_EXPIRES_IN=7d

# Where uploaded images (player photos, team logos) are stored, relative to the
# server/ directory. ../uploads = the uploads/ folder in the app root.
UPLOAD_DIR=../uploads

# One-time super-admin seed (used only by `npm run db:seed -w server`).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=REPLACE_ME_strong_password

# Shared hosting (CloudLinux/cPanel/Hostinger): Prisma's default in-process
# engine can panic under the host's thread limits ("timer has gone away").
# Uncomment to use the separate-process binary engine instead, then run
# `npm run prisma:generate -w server` once.
#PRISMA_CLIENT_ENGINE_TYPE=binary
